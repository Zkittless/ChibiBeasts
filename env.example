# ChibiBeasts configuration
# Copy to .env for local runs, or set these in Railway's Variables tab.
# Required: bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Your numeric Discord user ID. Controls owner-only sync and developer tools.
OWNER_ID=0

# Home server for /dev commands. Global player commands work in every server.
# Leave both IDs at 0 to disable developer tools.
GUILD_ID=0

# Optional: public HTTPS directory containing the 82 <beast_id>.png files.
# The default serves the versioned artwork from this repository's main branch.
# For a preview deployment, point this at the corresponding branch or CDN.
# BEAST_IMAGE_BASE_URL=https://raw.githubusercontent.com/Zkittless/ChibiBeasts/main/data/sprites
